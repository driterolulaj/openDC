    "/api/v1/audit": {
      "get": {
        "operationId": "listAudit",
        "summary": "Audit log, newest first",
        "tags": [
          "audit"
        ],
        "x-opendc-auth": {
          "permission": "core.audit.read"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "originNodeId": {
                            "type": "string"
                          },
                          "seq": {
                            "type": "number"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "actor": {
                            "type": "string"
                          },
                          "actorSid": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "sourceIp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "action": {
                            "type": "string"
                          },
                          "result": {
                            "type": "string"
                          },
                          "targetGuid": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "targetDn": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "requestId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "originNodeId",
                          "seq",
                          "ts",
                          "actor",
                          "actorSid",
                          "sourceIp",
                          "action",
                          "result",
                          "targetGuid",
                          "targetDn",
                          "requestId"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "entries"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
