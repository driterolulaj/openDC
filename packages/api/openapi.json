    "/api/v1/setup/join": {
      "post": {
        "operationId": "startSetupJoin",
        "summary": "Join this host to an existing domain as an additional DC (setup token, typed confirmation)",
        "tags": [
          "setup"
        ],
        "x-opendc-auth": "public",
        "security": [],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fqdn": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "hostIp": {
                    "type": "string",
                    "format": "ipv4",
                    "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                  },
                  "dnsForwarders": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "ipv4",
                      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                    }
                  },
                  "ntpServers": {
                    "default": [],
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^[A-Za-z0-9.-]+$"
                    }
                  },
                  "ntpAllow": {
                    "default": [],
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}\\/(\\d|[12]\\d|3[0-2])$"
                    }
                  },
                  "domain": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "dcHost": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "ipv4",
                        "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                      },
