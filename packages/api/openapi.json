{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenDC API",
    "version": "0.1.0",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-opendc_sid"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "fix",
          "params"
        ],
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/audit": {
      "get": {
        "operationId": "listAudit",
        "summary": "Audit log, newest first",
        "tags": [
          "audit"
        ],
        "x-opendc-auth": {
          "permission": "core.audit.read"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "originNodeId": {
                            "type": "string"
                          },
                          "seq": {
                            "type": "number"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "actor": {
                            "type": "string"
                          },
                          "actorSid": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "sourceIp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "action": {
                            "type": "string"
                          },
                          "result": {
                            "type": "string"
                          },
                          "targetGuid": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "targetDn": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "requestId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "originNodeId",
                          "seq",
                          "ts",
                          "actor",
                          "actorSid",
                          "sourceIp",
                          "action",
                          "result",
                          "targetGuid",
                          "targetDn",
                          "requestId"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "entries"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness check",
        "tags": [
          "core"
        ],
        "x-opendc-auth": "public",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Job state",
        "tags": [
          "jobs"
        ],
        "x-opendc-auth": {
          "permission": "core.jobs.read"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "running",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "result": {},
                    "error": {}
                  },
                  "required": [
                    "id",
                    "type",
                    "actor",
                    "status",
                    "createdAt",
                    "updatedAt",
                    "result",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/events": {
      "get": {
        "operationId": "streamJobEvents",
        "summary": "Job progress as server-sent events (supports Last-Event-ID)",
        "tags": [
          "jobs"
        ],
        "x-opendc-auth": {
          "permission": "core.jobs.read"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/node-info": {
      "post": {
        "operationId": "startNodeInfoJob",
        "summary": "Start a job that collects node information through the agent (exercises jobs and SSE)",
        "tags": [
          "jobs"
        ],
        "x-opendc-auth": {
          "permission": "core.node.info"
        },
        "parameters": [],
        "responses": {
          "202": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "running",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "result": {},
                    "error": {}
                  },
                  "required": [
                    "id",
                    "type",
                    "actor",
                    "status",
                    "createdAt",
                    "updatedAt",
                    "result",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/node": {
      "get": {
        "operationId": "getNode",
        "summary": "This node: OS, role, versions (through the agent)",
        "tags": [
          "node"
        ],
        "x-opendc-auth": {
          "permission": "core.node.info"
        },
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hostname": {
                      "type": "string"
                    },
                    "fqdn": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "os": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "versionId": {
                          "type": "string"
                        },
                        "prettyName": {
                          "type": "string"
                        },
                        "adapter": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "versionId",
                        "prettyName",
                        "adapter"
                      ],
                      "additionalProperties": false
                    },
                    "kernel": {
                      "type": "string"
                    },
                    "uptimeSec": {
                      "type": "number"
                    },
                    "cpus": {
                      "type": "number"
                    },
                    "memTotal": {
                      "type": "number"
                    },
                    "samba": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "platformVersion": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "hostname",
                    "fqdn",
                    "role",
                    "os",
                    "kernel",
                    "uptimeSec",
                    "cpus",
                    "memTotal",
                    "samba",
                    "platformVersion"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "delete": {
        "operationId": "logout",
        "summary": "Log out",
        "tags": [
          "session"
        ],
        "x-opendc-auth": "session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getSession",
        "summary": "The current session and its CSRF token",
        "tags": [
          "session"
        ],
        "x-opendc-auth": "session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "sid": {
                          "type": "string"
                        },
                        "guid": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dn": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sid",
                        "guid",
                        "username",
                        "displayName",
                        "dn"
                      ],
                      "additionalProperties": false
                    },
                    "csrfToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "idleTimeoutSec": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "user",
                    "csrfToken",
                    "expiresAt",
                    "idleTimeoutSec"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "login",
        "summary": "Log in with domain credentials (LDAPS bind against a verified DC)",
        "tags": [
          "session"
        ],
        "x-opendc-auth": "public",
        "security": [],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "username",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "sid": {
                          "type": "string"
                        },
                        "guid": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dn": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sid",
                        "guid",
                        "username",
                        "displayName",
                        "dn"
                      ],
                      "additionalProperties": false
                    },
                    "csrfToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "idleTimeoutSec": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "user",
                    "csrfToken",
                    "expiresAt",
                    "idleTimeoutSec"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/permissions": {
      "get": {
        "operationId": "getPermissions",
        "summary": "Effective permissions of the current user (for display; the server enforces regardless)",
        "tags": [
          "session"
        ],
        "x-opendc-auth": "session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "permission": {
                            "type": "string"
                          },
                          "scopes": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "domain"
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "subtree"
                                    },
                                    "dn": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "dn"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "node"
                                    },
                                    "nodeGuid": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "nodeGuid"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          },
                          "tier0": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "permission",
                          "scopes",
                          "tier0"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "permissions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
