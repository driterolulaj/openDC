# SPDX-License-Identifier: AGPL-3.0-only
# Creates missing node-local secrets (HMAC key, self-signed console certificate, local Samba CA copy)
# before the services that load them start. Never overwrites existing secrets.
[Unit]
Description=OpenDC secrets initialisation
Before=opendc-agent.service opendc-api.service opendc-watcher.service
After=local-fs.target network-online.target samba-ad-dc.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/opendc/node/bin/node --disable-warning=ExperimentalWarning /usr/lib/opendc/app/node_modules/@opendc/agent/dist/main.js --init-secrets
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
