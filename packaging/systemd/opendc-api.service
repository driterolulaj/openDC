# SPDX-License-Identifier: AGPL-3.0-only
# Console and REST API (unprivileged, SECURITY.md §6). Secrets arrive as systemd credentials only.
[Unit]
Description=OpenDC API and console
After=network-online.target opendc-secrets-init.service opendc-agent-api.socket samba-ad-dc.service
Wants=network-online.target opendc-agent-api.socket
Requires=opendc-secrets-init.service

[Service]
Type=simple
User=_opendc-api
Group=_opendc-api
ExecStart=/usr/lib/opendc/node/bin/node --disable-warning=ExperimentalWarning /usr/lib/opendc/app/node_modules/@opendc/api/dist/main.js
LoadCredential=tls-cert:/etc/opendc/secrets/tls-cert.pem
LoadCredential=tls-key:/etc/opendc/secrets/tls-key.pem
LoadCredential=ldap-ca:/etc/opendc/secrets/ldap-ca.pem
LoadCredential=api-hmac:/etc/opendc/secrets/api-hmac
LoadCredential=ldap-svc:/etc/opendc/secrets/ldap-svc
StateDirectory=opendc/api
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# V8's JIT needs writable+executable memory (documented in SECURITY.md §6).
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KeyringMode=private
RemoveIPC=yes
PrivateUsers=no

[Install]
WantedBy=multi-user.target
