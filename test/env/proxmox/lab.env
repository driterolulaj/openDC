# MyUCS VM lab on Proxmox VE: defaults. Override any value by exporting it before running pve-lab.sh,
# or by creating lab.local.env next to this file (git-ignored).
# Nothing here is a secret. Lab passwords are generated on the gateway node under /root/myucs-lab/secrets.

# SDN: one VXLAN zone spanning every cluster node, so lab VMs on different nodes share one L2 segment.
LAB_ZONE="${LAB_ZONE:-myucs}"            # SDN zone id, max 8 chars
LAB_VNET="${LAB_VNET:-mylab0}"           # SDN vnet id, max 8 chars
LAB_VXLAN_TAG="${LAB_VXLAN_TAG:-9710}"
LAB_MTU="${LAB_MTU:-1450}"               # uplink MTU minus 50 bytes VXLAN overhead

# Lab subnet. The gateway node routes it to the uplink with NAT and blocks all private destinations,
# so lab services (Samba DNS, Kea DHCP) can never reach or answer the site LAN.
LAB_CIDR="${LAB_CIDR:-10.97.10.0/24}"
LAB_GW="${LAB_GW:-10.97.10.1}"
LAB_PREFIX="${LAB_PREFIX:-24}"
LAB_UPLINK="${LAB_UPLINK:-vmbr0}"
LAB_DNS="${LAB_DNS:-1.1.1.1 9.9.9.9}"    # used until a lab DC provides DNS
# The only inbound path into the lab: TCP port forwards from the gateway node's uplink address,
# "<gateway port>:<lab ip>:<port>" separated by spaces. Default: the future HTTPS console on dc1 and dc2.
LAB_PORT_FORWARDS="${LAB_PORT_FORWARDS-8441:10.97.10.11:443 8442:10.97.10.12:443}"
LAB_DOMAIN_SUFFIX="${LAB_DOMAIN_SUFFIX:-myucs.test}" # topology <t> gets realm <t>.<suffix>, NetBIOS name <T>
LAB_FORWARDER="${LAB_FORWARDER:-1.1.1.1}"           # DNS forwarder of lab DCs

# Storage and IDs
LAB_STORAGE="${LAB_STORAGE:-local-lvm}"          # VM disks (must support snapshots)
LAB_IMPORT_STORAGE="${LAB_IMPORT_STORAGE:-local}" # cloud images (needs the 'import' content type)
LAB_VMID_BASE="${LAB_VMID_BASE:-2000}"           # lab VM id = base + last octet of its IP
LAB_TPL_BASE="${LAB_TPL_BASE:-9000}"             # template id = base + node index * 100 + image slot
LAB_TAG="${LAB_TAG:-myucs-lab}"                  # only VMs carrying this tag are ever destroyed
LAB_CIUSER="${LAB_CIUSER:-myucs}"
